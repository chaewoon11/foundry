#!/usr/bin/env bash
# Run the holdout set. stdout carries ONLY per-kind pass/fail counts; details go to audit/private/.
# A skipped holdout test counts as a failure: holdout cases must be valid by construction.
set -uo pipefail
cd "$(dirname "$0")/.."
mkdir -p audit/private
summary="$(mktemp)"
HOLDOUT_SUMMARY="$summary" PYTHONPATH="${SRC_DIR:-src}:scripts" \
  python3 -m pytest tests/holdout -p holdout_summary -q \
  --junitxml=audit/private/holdout-junit.xml >audit/private/holdout.log 2>&1
cat "$summary"
fails="$(awk '/^total /{split($3,a,"="); print a[2]}' "$summary")"
rm -f "$summary"
[ "${fails:-1}" = "0" ]
