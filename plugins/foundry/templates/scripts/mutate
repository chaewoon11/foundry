#!/usr/bin/env bash
# Mutation testing on a COPY of the main code; the original is never touched.
#   mutate --baseline            unmodified code must pass public + holdout; records the time
#   mutate <patch> [--id ID]     apply a unified diff (paths a/<source path>/..., b/...) to a copy,
#                                run public + holdout with FOUNDRY_SRC pointing at the copy
# stdout: "<ID> KILLED" | "<ID> SURVIVED" | "<ID> INVALID". Timeout max(600 s, 5 x baseline) counts as KILLED.
set -uo pipefail
source "$(dirname "$0")/_common.sh"
priv="$CODE/audit/private"; mkdir -p "$priv/work" "$priv/mutants"

suite() {  # $1 = FOUNDRY_SRC value ("" for the original), $2 = log dir
  FOUNDRY_SRC="$1" "$CODE/scripts/run-public-tests" -q -x && \
  FOUNDRY_SRC="$1" HOLDOUT_LOG_DIR="$2" "$CODE/scripts/run-holdout"
}

if [ "${1:-}" = "--baseline" ]; then
  start=$(date +%s)
  if (unset FOUNDRY_SRC; suite "" "$priv/mutants/baseline") >"$priv/mutants/baseline.log" 2>&1; then
    echo $(( $(date +%s) - start )) >"$priv/baseline_seconds"; echo "baseline PASS ($(cat "$priv/baseline_seconds") s)"; exit 0
  fi
  echo "baseline FAIL: the unmodified code must pass public + holdout before mutants count"; exit 1
fi

patchfile="$(cd "$(dirname "${1:?usage: mutate <patch> [--id ID] | --baseline}")" && pwd)/$(basename "$1")"
id="$(basename "$patchfile")"; id="${id%.*}"
[ "${2:-}" = "--id" ] && id="${3:?missing ID}"
[ -f "$priv/baseline_seconds" ] || { echo "run mutate --baseline first"; exit 2; }
limit=$(( $(cat "$priv/baseline_seconds") * 5 )); [ "$limit" -lt 600 ] && limit=600

work="$priv/work/$id"; log="$priv/mutants/$id.log"
rm -rf "$work"; mkdir -p "$work"
for s in $SOURCES; do mkdir -p "$work/$(dirname "$s")"; cp -r "$ROOT/$s" "$work/$s"; done
# Drop bytecode caches from the copy: a cache can look valid for a same-size edit made within the same
# second and would then run the unmutated code.
find "$work" -name __pycache__ -type d -prune -exec rm -rf {} + 2>/dev/null; find "$work" -name '*.pyc' -delete 2>/dev/null
export PYTHONDONTWRITEBYTECODE=1
if ! patch -p1 -s -d "$work" <"$patchfile" >"$log" 2>&1; then echo "$id INVALID"; exit 0; fi
same=1; for s in $SOURCES; do diff -rq "$ROOT/$s" "$work/$s" >/dev/null || same=0; done
[ $same = 1 ] && { echo "$id INVALID"; exit 0; }
export -f suite; export CODE
timeout "$limit" bash -c 'suite "$0" "$1"' "$work" "$work/logs" >>"$log" 2>&1
case $? in 0) echo "$id SURVIVED" ;; *) echo "$id KILLED" ;; esac
