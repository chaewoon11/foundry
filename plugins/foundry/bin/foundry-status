#!/usr/bin/env python3
"""foundry status: stage of every code under <project>/foundry/, inferred from the files.

  foundry-status                  one block per code
  foundry-status <code>           one code only
  foundry-status --session-start  for the SessionStart hook: prints nothing when the
                                  project has no foundry/ folder; otherwise the status
                                  followed by the orchestrator rules
  foundry-status --with-rules     the orchestrator rules, then the status (always printed;
                                  used by foundry:start)

No state file: the stage comes from spec/, spec/issues/, the REVIEW.md records and
audit/. Staleness of an audit uses git commit order (fresh clones reset mtimes).
"""
import os
import re
import subprocess
import sys

PLUGIN = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(PLUGIN, "hooks"))
from foundry_layout import codes, project_root  # noqa: E402

ROOT = project_root()


def read(path):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except OSError:
        return None


def review(path):
    """None if absent; else (approved, decided, total, first_open)."""
    text = read(path)
    if text is None:
        return None
    approved = bool(re.search(r"^- Review status:\s*APPROVED", text, re.M))
    heads = list(re.finditer(r"^## \[(\d+)/(\d+)\]", text, re.M))
    decided, first_open = 0, None
    for i, m in enumerate(heads):
        body = text[m.end(): heads[i + 1].start() if i + 1 < len(heads) else len(text)]
        st = re.search(r"^- Status:\s*(\w+)", body, re.M)
        s = st.group(1).upper() if st else "PENDING"
        if s in ("APPROVED", "CHANGED"):
            decided += 1
        elif first_open is None:
            first_open = m.group(1)
    return approved, decided, len(heads), first_open


def review_line(name, r):
    if r is None:
        return f"{name}: not started"
    approved, decided, total, first_open = r
    if approved:
        return f"{name}: APPROVED"
    if first_open:
        return f"{name}: briefing {decided}/{total}, next item [{first_open}/{total}]"
    return f"{name}: all {total} items decided; apply edits, re-brief changes, approve"


def git(*args):
    r = subprocess.run(["git", "-C", ROOT, *args], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None


def changed_since_audit(code):
    watched = [os.path.join(code["dir"], "spec"), os.path.join(code["dir"], "tests")] + code["source"]
    verdict = os.path.join(code["dir"], "audit", "verdict.md")
    if git("rev-parse", "--is-inside-work-tree") == "true":
        if git("status", "--porcelain", "--", *watched):
            return True
        c = git("log", "-1", "--format=%H", "--", verdict)
        if not c:
            return False
        return bool(git("rev-list", f"{c}..HEAD", "--", *watched))
    t = 0.0
    for d in watched:
        for base, _, files in os.walk(os.path.join(ROOT, d)):
            for f in files:
                try:
                    t = max(t, os.path.getmtime(os.path.join(base, f)))
                except OSError:
                    pass
    return t > os.path.getmtime(os.path.join(ROOT, verdict))


def status(code):
    d = lambda *p: os.path.join(ROOT, code["dir"], *p)  # noqa: E731
    issues_dir = d("spec", "issues")
    open_issues = sorted(
        f for f in (os.listdir(issues_dir) if os.path.isdir(issues_dir) else [])
        if f.endswith(".md") and f != "REVIEW.md" and "## Resolution" not in (read(os.path.join(issues_dir, f)) or "")
    )
    spec_r = review(d("spec", "REVIEW.md"))
    tests_r = review(d("tests", "REVIEW.md"))
    report_r = review(d("audit", "REVIEW.md"))
    vt = read(d("audit", "verdict.md"))
    verdict = None
    if vt:
        m = re.search(r"\b(PASS|FAIL-COVERAGE|FAIL-MUTATION|FAIL-HOLDOUT|SPEC-ISSUE)\b", vt)
        verdict = m.group(1) if m else "UNKNOWN"

    if open_issues:
        stage, nxt = "spec issues", "brief each open spec issue to the user (foundry:spec, issues mode)"
    elif not (spec_r and spec_r[0]):
        stage = "1 spec"
        nxt = "continue the spec briefing (foundry:brief)" if spec_r else "write the spec with the user (foundry:spec)"
    elif not (tests_r and tests_r[0]):
        stage = "2 tests & oracle"
        nxt = "continue the test-rule briefing (foundry:brief)" if tests_r else "build the test set and oracle (foundry:design-tests)"
    elif verdict is None:
        stage, nxt = "3 develop", "develop until public tests pass (foundry:develop), then audit (foundry:audit)"
    elif changed_since_audit(code):
        stage, nxt = "3 develop", "code, tests or spec changed after the last audit: develop if needed, then re-audit"
    elif verdict == "PASS":
        if report_r and report_r[0]:
            stage, nxt = "done", "nothing: report approved"
        else:
            stage, nxt = "4 report", "brief the verification report (foundry:report)"
    elif verdict in ("FAIL-COVERAGE", "FAIL-MUTATION"):
        stage, nxt = "4 audit failed", "ask the user; usually strengthen tests (foundry:design-tests fix-audit), then re-audit"
    elif verdict == "FAIL-HOLDOUT":
        stage, nxt = "4 audit failed", "ask the user; usually fix code (foundry:develop, failing kinds only), then re-audit"
    else:
        stage, nxt = "4 audit", "read the verdict and ask the user"

    lines = [f"{code['name']}  [{code['level']}]  stage: {stage}",
             f"  main code: {', '.join(code['source']) or '(not set)'}",
             f"  {review_line('spec', spec_r)} | {review_line('test rules', tests_r)}",
             f"  open spec issues: {len(open_issues)}" + (f" ({', '.join(open_issues)})" if open_issues else "")
             + f" | audit verdict: {verdict or 'none'}",
             f"  next: {nxt}"]
    return lines


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    session = "--session-start" in sys.argv
    rules_first = "--with-rules" in sys.argv
    rules = read(os.path.join(PLUGIN, "skills", "start", "RULES.md")) or ""
    if rules_first:
        print(rules.strip() + "\n")
    cs = codes(ROOT)
    if args:
        cs = [c for c in cs if c["name"] in args]
    if not cs:
        if not session:
            print("[foundry] no code in this project yet (no foundry/<code>/foundry.json). Start one with /foundry:start.")
        return
    out = ["[foundry] status"]
    for c in cs:
        out += status(c)
    if session and rules:
        out += ["", rules.strip()]
    print("\n".join(out))


if __name__ == "__main__":
    main()
